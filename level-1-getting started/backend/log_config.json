{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    },
    "file": {
      "format": "%(asctime)s %(levelname)-7s %(name)s: %(message)s"
    }
  },
  "filters": {
    "quiet_poll": {
      "()": "backend.log_filter.QuietPollFilter"
    },
    "console_only_major": {
      "()": "backend.log_setup.ConsoleFilter"
    },
    "kafka_dedupe": {
      "()": "backend.log_setup.KafkaDedupeFilter"
    }
  },
  "handlers": {
    "console": {
      "formatter": "default",
      "filters": ["console_only_major"],
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "console_access": {
      "formatter": "access",
      "filters": ["quiet_poll", "console_only_major"],
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "()": "backend.log_setup.make_file_handler",
      "formatter": "file",
      "filters": ["quiet_poll"]
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console_access", "file"],
      "level": "INFO",
      "propagate": false
    },
    "hive": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "hive.kafka": {
      "filters": ["kafka_dedupe"],
      "level": "INFO",
      "propagate": true
    }
  }
}
