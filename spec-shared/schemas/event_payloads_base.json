{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.example.com/schemas/events.json",
  "definitions": {
    "connection.test": {
      "type": "object",
      "required": ["operation_id", "probe"],
      "properties": {
        "operation_id": { "type": "string", "format": "uuid" },
        "probe": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "simulation.initialized": {
      "description": "Published once to simulation-state (compact topic) when provisioning succeeds.",
      "type": "object",
      "required": ["operation_id", "attendee_id", "expires_at", "station_recipes", "simulation_config"],
      "properties": {
        "operation_id": { "type": "string", "format": "uuid" },
        "attendee_id": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "station_recipes": {
          "type": "object",
          "description": "BOM per station: station_id → { input_id: quantity }",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        },
        "simulation_config": {
          "type": "object",
          "required": ["workstation_tiers", "robot_prices", "max_station_slots", "station_initial_tiers"],
          "properties": {
            "workstation_tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tier", "cost_purchase", "cost_upgrade", "interval_sim_minutes"],
                "properties": {
                  "tier": { "type": "integer", "minimum": 1 },
                  "cost_purchase": { "type": "integer", "minimum": 0 },
                  "cost_upgrade": { "type": "integer" },
                  "interval_sim_minutes": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "robot_prices": {
              "type": "object",
              "description": "robot_type → price_in_coins",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "max_station_slots": { "type": "integer", "minimum": 1 },
            "station_initial_tiers": {
              "type": "object",
              "description": "station_id → initial tier number",
              "additionalProperties": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "topics": {
    "gathering.started": {
      "type": "object",
      "required": ["job_id", "station_id", "quantity"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": { "type": "string", "enum": ["resin", "silicon", "metals", "copper", "energy"] },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "gathering.completed": {
      "type": "object",
      "required": ["job_id", "station_id", "quantity"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": { "type": "string", "enum": ["resin", "silicon", "metals", "copper", "energy"] },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "manufacturing.started": {
      "type": "object",
      "required": ["job_id", "station_id", "output_type", "inputs"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": {
          "type": "string",
          "enum": [
            "chassis",
            "electronics",
            "actuator",
            "battery"
          ]
        },
        "output_type": {
          "type": "string",
          "enum": ["chassis", "electronics", "actuator", "battery"]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "manufacturing.completed": {
      "type": "object",
      "required": ["job_id", "station_id", "part_id", "quantity"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": {
          "type": "string",
          "enum": [
            "chassis",
            "electronics",
            "actuator",
            "battery"
          ]
        },
        "part_id": {
          "type": "string",
          "enum": ["chassis", "electronics", "actuator", "battery"]
        },
        "quantity": { "type": "integer", "const": 1 }
      },
      "additionalProperties": false
    },
    "manufacturing.blocked": {
      "type": "object",
      "required": ["station_id", "missing_inputs"],
      "properties": {
        "station_id": {
          "type": "string",
          "enum": [
            "chassis",
            "electronics",
            "actuator",
            "battery"
          ]
        },
        "missing_inputs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "manufacturing.resources.acquired": {
      "type": "object",
      "description": "Emitted every time resources are moved from Simulation stock into a manufacturing station's staging cart. May fire multiple times per job as stock arrives incrementally. inputs_acquired is the delta for this transfer only.",
      "required": ["station_id", "inputs_acquired"],
      "properties": {
        "station_id": {
          "type": "string",
          "enum": [
            "chassis",
            "electronics",
            "actuator",
            "battery"
          ]
        },
        "inputs_acquired": {
          "type": "object",
          "description": "Resources removed from Simulation stock in this transfer (delta, not cumulative).",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "assembly.started": {
      "type": "object",
      "required": ["job_id", "station_id", "output_type", "inputs"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "output_type": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "assembly.completed": {
      "type": "object",
      "required": ["job_id", "station_id", "output_type", "quantity"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "station_id": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "output_type": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "quantity": { "type": "integer", "const": 1 }
      },
      "additionalProperties": false
    },
    "assembly.blocked": {
      "type": "object",
      "required": ["station_id", "missing_inputs"],
      "properties": {
        "station_id": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "missing_inputs": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "assembly.parts.acquired": {
      "type": "object",
      "description": "Emitted every time parts are moved from parts inventory into an assembly station's staging cart. May fire multiple times per robot job as parts become available incrementally. inputs_acquired is the delta for this transfer only.",
      "required": ["station_id", "inputs_acquired"],
      "properties": {
        "station_id": {
          "type": "string",
          "enum": ["engineer", "gatherer", "builder"]
        },
        "inputs_acquired": {
          "type": "object",
          "description": "Parts removed from parts inventory in this transfer (delta, not cumulative).",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "assembly.state": {
      "type": "object",
      "required": ["robot_queue"],
      "properties": {
        "robot_queue": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "simulation.state": {
      "type": "object",
      "required": [
        "lifecycle_status",
        "running"
      ],
      "properties": {
        "lifecycle_status": {
          "type": "string",
          "enum": ["paused", "running", "stopped", "expired"]
        },
        "running": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
